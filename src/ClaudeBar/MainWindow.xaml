<Window x:Class="ClaudeBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeBar"
        Title="ClaudeBar"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <!-- The margin is the room the drop shadow falls into. Without it the blur is clipped by
       the window's own rectangle, which draws exactly what it sounds like: square, faintly
       grey corners around the rounded pill. Everything that positions the pill measures the
       shell, not the window - see MainWindow.PillBounds. Keep this in step with
       MainWindow.ShadowDip. -->
  <Border x:Name="Shell"
          Margin="10"
          CornerRadius="9"
          Padding="9,6,9,6"
          BorderBrush="#33FFFFFF"
          BorderThickness="1">
    <Border.Background>
      <SolidColorBrush x:Name="ShellFill" Color="#151922" Opacity="0.92"/>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="Black"/>
    </Border.Effect>

    <StackPanel>
      <!-- One section per account. Shared size scope spans every section, so every row of
           every account lines up on the same columns. -->
      <ItemsControl x:Name="Accounts" Visibility="Collapsed" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Opacity="{Binding Opacity}" Margin="0,0,0,4" ToolTip="{Binding Tooltip}">

              <!-- Header. The controls are plain elements with a Tag; the window hit-tests
                   the click and routes it, because the drag handling captures the mouse and
                   ordinary Click events never reach elements inside the pill. -->
              <Grid Margin="0,0,0,3">
                <Grid.Resources>
                  <Style x:Key="Tap" TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#22FFFFFF"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Radio: filled for the active account; click an empty one to switch. -->
                <Border Grid.Column="0" Tag="radio" Style="{StaticResource Tap}"
                        Padding="3,1,6,1" Margin="-4,0,2,0" ToolTip="{Binding RadioTip}">
                  <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                             FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Email}" Foreground="#A9B4C8"
                           FontFamily="Segoe UI" FontSize="10.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="260"/>

                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#FBBF24"
                           Visibility="{Binding StatusVisibility}"
                           FontFamily="Segoe UI" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <!-- Collapsed view only: the switch button opens the picker. -->
                <Border Grid.Column="3" Tag="switch" Style="{StaticResource Tap}"
                        Visibility="{Binding SwitchVisibility}" Padding="6,2,6,2" Margin="10,0,0,0"
                        ToolTip="Switch account">
                  <TextBlock Text="&#xE8AB;" Foreground="#C8D2E4"
                             FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                </Border>

                <!-- Expand / collapse between one account and all of them. -->
                <Border Grid.Column="4" Tag="toggle" Style="{StaticResource Tap}"
                        Visibility="{Binding ToggleVisibility}" Padding="6,2,6,2" Margin="2,0,0,0"
                        ToolTip="{Binding ToggleTip}">
                  <TextBlock Text="{Binding ToggleGlyph}" Foreground="#C8D2E4"
                             FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                </Border>

                <!-- Minimize to a single line of numbers. -->
                <Border Grid.Column="5" Tag="mini" Style="{StaticResource Tap}"
                        Visibility="{Binding MiniVisibility}" Padding="6,2,5,2" Margin="2,0,-4,0"
                        ToolTip="Minimize to just the numbers">
                  <TextBlock Text="&#xE921;" Foreground="#C8D2E4"
                             FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                </Border>
              </Grid>

              <!-- Cue 1 shape, cue 2 countable segments, cue 3 the number. Never colour alone. -->
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,1.5,0,1.5" ToolTip="{Binding Tooltip}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Bar"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Chip"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Reset"/>
                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#9AA5B8"
                                 FontFamily="Segoe UI" FontSize="11.5" VerticalAlignment="Center"/>

                      <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{Binding Accent}"
                                 FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                      <local:SegmentBar Grid.Column="2"
                                        Percent="{Binding PercentValue}"
                                        Accent="{Binding Accent}"
                                        Track="{x:Static local:LimitRow.Track}"
                                        Segments="12"
                                        VerticalAlignment="Center"
                                        Margin="4,0,8,0"/>

                      <Border Grid.Column="3"
                              Background="{x:Static local:LimitRow.ChipFill}"
                              CornerRadius="4" Padding="5,0,5,1"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Percent}" Foreground="#F2F5FA"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                      </Border>

                      <TextBlock Grid.Column="4" Text="{Binding Reset}" Foreground="#C8D2E4"
                                 FontFamily="Segoe UI" FontSize="11.5" Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Mini layout: the active account's numbers on one line, plus a restore button. -->
      <StackPanel x:Name="MiniPanel" Orientation="Horizontal" Visibility="Collapsed">
        <StackPanel.Resources>
          <Style x:Key="Tap" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#22FFFFFF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Resources>

        <ItemsControl x:Name="MiniRows">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,8,0" ToolTip="{Binding Tooltip}">
                <TextBlock Text="{Binding Label}" Foreground="#9AA5B8" FontFamily="Segoe UI"
                           FontSize="10.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="9"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Percent}" Foreground="#F2F5FA" FontFamily="Segoe UI"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Segoe MDL2 Assets: ChromeMaximize. -->
        <Border Tag="restore" Style="{StaticResource Tap}" Padding="6,2,5,2" Margin="2,0,-4,0"
                VerticalAlignment="Center" ToolTip="Restore the full pill">
          <TextBlock Text="&#xE922;" Foreground="#C8D2E4"
                     FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>

      <!-- Degraded state: Claude Code missing, signed out, or offline. Never a crash. -->
      <StackPanel x:Name="MessagePanel" Orientation="Horizontal" Visibility="Visible">
        <TextBlock Text="◌" Foreground="#9AA5B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="MessageText" Text="starting…" Foreground="#C9D1DE"
                   FontFamily="Segoe UI" FontSize="11.5" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
