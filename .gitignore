# Build output
bin/
obj/
*.user

# Published binaries: a 72MB exe does not belong in the repo.
# It is built into release/ locally and published through GitHub Releases instead.
release/

# Runtime settings written next to the exe
settings.json

# NEVER commit captured account material.
# ClaudeBar stores per-account credential copies under %LOCALAPPDATA%\ClaudeBar\accounts,
# but belt and braces: nothing credential-shaped may ever enter this repo.
accounts/
*.credentials.json
.credentials.json
credentials*.json
*.token
*.pem
backups/
